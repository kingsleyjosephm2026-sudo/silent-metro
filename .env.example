# Copy to .env and export these variables (the app reads process.env; no dotenv dependency).
PORT=3000
HOST=127.0.0.1
# Demo user passwords (defaults are for local demo only; change for any shared deployment)
SM_OPERATOR_PASSWORD=change-me-operator
SM_PASSENGER_PASSWORD=change-me-passenger
# Device API keys: deviceId:secret[,deviceId2:secret2]
SM_DEVICE_KEYS=esp32-demo-01:replace-with-long-random-device-key
# Set to 1 when served over HTTPS so cookies get the Secure flag
SM_SECURE_COOKIES=0
# Set to 0 to stop the simulator auto-starting
SM_AUTOSTART_SIM=1
# Optional: custom location for the JSON data file
# DATA_FILE=./data/db.json
